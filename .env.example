ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Option 2: Green-API (https://green-api.com - Scan QR with 9824751053)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Option 3: Custom Webhook
WHATSAPP_WEBHOOK_URL=

